# ============================================================
# IRKOP BLOGGER MCP
# Copy this file to .env and fill in the values.
# DO NOT commit the real .env file.
# ============================================================

# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
MCP_PATH=/mcp

# Public MCP URL
PUBLIC_BASE_URL=https://mcp.irkop.eu.org

# ============================================================
# MCP AUTHENTICATION
# ============================================================

# Generate a long random secret.
MCP_AUTH_TOKEN=YOUR_LONG_RANDOM_MCP_TOKEN

# ============================================================
# BLOGGER DEFAULT BLOG
# ============================================================

BLOGGER_BLOG_URL=https://blog.irkop.eu.org/
BLOGGER_BLOG_ID=

# ============================================================
# GOOGLE / BLOGGER API
# Preferred: OAuth refresh credentials.
# ============================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Temporary development alternative.
# Leave empty in production when using refresh credentials.
BLOGGER_ACCESS_TOKEN=

# ============================================================
# IRKOP THEME BRIDGE
# Blogger API v3 does not directly expose Theme XML management.
# Leave empty until Theme Bridge is deployed.
# ============================================================

THEME_BRIDGE_URL=
THEME_BRIDGE_TOKEN=

# ============================================================
# OPTIONAL SUPABASE / IRKOP INTEGRATION
# Only fill these if this MCP needs to read IRKOP app/project data.
# ============================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=

# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=info
