# Google OAuth token source. Never commit real values.
BLOGGER_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional default blog.
BLOGGER_BLOG_ID=
BLOGGER_BLOG_URL=https://blog.irkop.eu.org/

# Optional IRKOP Theme Bridge.
# Blogger API v3 does not expose Theme XML upload/update.
THEME_BRIDGE_URL=
THEME_BRIDGE_TOKEN=
