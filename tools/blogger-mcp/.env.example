# ============================================================
# IRKOP BLOGGER MCP
# Copy this file to .env and fill in the values.
# DO NOT commit the real .env file.
# ============================================================

# ============================================================
# SERVER
# ============================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
MCP_PATH=/mcp

# Public URL
# Cloudflare Tunnel target:
# https://mcp.irkop.eu.org/mcp
PUBLIC_BASE_URL=https://mcp.irkop.eu.org


# ============================================================
# MCP AUTHENTICATION
# ============================================================

# Generate your own long random secret.
# Example generator:
# https://www.uuidgenerator.net/
MCP_AUTH_TOKEN=


# ============================================================
# BLOGGER
# ============================================================

# Blog URL
BLOGGER_BLOG_URL=https://blog.irkop.eu.org/

# Blogger Blog ID
# Get it from:
# https://developers.google.com/blogger/docs/3.0/using
# API method:
# GET https://www.googleapis.com/blogger/v3/blogs/byurl?url=https://blog.irkop.eu.org/
BLOGGER_BLOG_ID=


# ============================================================
# GOOGLE / BLOGGER API
# ============================================================

# First enable Blogger API:
# https://console.cloud.google.com/apis/library
#
# Then create OAuth credentials:
# https://console.cloud.google.com/apis/credentials
#
# APIs & Services -> Credentials -> Create Credentials
# -> OAuth Client ID

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ============================================================
# GOOGLE REFRESH TOKEN
# ============================================================

# Get authorization / refresh token from:
# https://developers.google.com/oauthplayground/
#
# Blogger OAuth scope:
# https://www.googleapis.com/auth/blogger
#
# OAuth Playground flow:
# 1. Open the link above
# 2. Click the settings icon
# 3. Enable "Use your own OAuth credentials"
# 4. Enter GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
# 5. Add the Blogger scope above
# 6. Authorize with the Google account that owns the blog
# 7. Exchange authorization code for tokens
# 8. Copy the refresh token here

GOOGLE_REFRESH_TOKEN=


# ============================================================
# TEMPORARY GOOGLE ACCESS TOKEN
# ============================================================

# Optional for temporary testing.
# Leave empty in production if GOOGLE_REFRESH_TOKEN is configured.
BLOGGER_ACCESS_TOKEN=


# ============================================================
# IRKOP THEME BRIDGE
# ============================================================

# Blogger API v3 does not directly expose Blogger Theme XML upload/update.
# This optional IRKOP service will handle:
# - theme backup
# - theme validation
# - theme deployment
#
# Planned URL example:
# https://mcp.irkop.eu.org/theme

THEME_BRIDGE_URL=
THEME_BRIDGE_TOKEN=


# ============================================================
# OPTIONAL SUPABASE / IRKOP INTEGRATION
# ============================================================

# Get from Supabase Project Settings -> API:
# https://supabase.com/dashboard
#
# Project URL:
SUPABASE_URL=
#
# Publishable / anon key only:
SUPABASE_ANON_KEY=


# ============================================================
# LOGGING
# ============================================================

# debug | info | warn | error
LOG_LEVEL=info
